# Copy this file to .env (already gitignored) and fill in the values you
# need. Every variable here is optional except where noted -- the app tells
# you which ones are missing when you try to use a feature that needs them.

# --- Supabase (required to run the Streamlit app, app.py) ---
# Run the SQL in database.py's and archive.py's module docstrings in
# Supabase's SQL editor first, and create a Storage bucket matching
# SUPABASE_STORAGE_BUCKET below.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Document classification (required only for the upload/intake feature) ---
ANTHROPIC_API_KEY=

# --- Google Sheets sync (CLI `sync` command only) ---
GOOGLE_SHEETS_CREDENTIALS_PATH=

# --- Email sending (optional; drafts are always written to disk regardless) ---
# Set EMAIL_SEND_MODE=live plus all four SMTP_* vars to actually send.
EMAIL_SEND_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
